# Rider Coaching Center environment example
# Copy to .env for local development. Do not commit real .env files.

# Backend API server port. Change this in production if the host assigns a port.
PORT=4100

# Vite frontend port used for local operation checks.
FRONTEND_PORT=5174

# Frontend API target. In production, set this to the deployed backend origin.
VITE_API_BASE_URL=http://localhost:4100

# Local Ollama / Gemma 4 settings.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_MS=30000
OLLAMA_STATUS_TIMEOUT_MS=60000

# Use development locally. Set to production in deployed runtime.
NODE_ENV=development

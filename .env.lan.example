# Rider Coaching Center LAN beta environment template
# Copy to a real .env only when running the Galaxy Book 5 as a local beta server.
# Do not commit a real .env file.

NODE_ENV=development
PORT=4100
FRONTEND_PORT=5174

# Replace <GALAXYBOOK_IP> with the current IPv4 address of the Galaxy Book 5.
# Example: VITE_API_BASE_URL=http://192.168.0.25:4100
# This is for phones/PCs on the same Wi-Fi network.
VITE_API_BASE_URL=http://<GALAXYBOOK_IP>:4100

# Use local Ollama/Gemma 4 first, then template fallback if it fails.
AI_PROVIDER=ollama
AI_MODE=auto
AI_FALLBACK_ENABLED=true
STORAGE_MODE=json

# Ollama runs on the Galaxy Book 5 itself.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_MS=30000
OLLAMA_STATUS_TIMEOUT_MS=60000

# For external Internet sharing, do not use this file alone.
# See docs/TUNNEL_BETA_GUIDE.md for Cloudflare Tunnel or ngrok preparation.

# Rider Coaching Center Beta environment template
# Copy this file to .env for local beta testing. Do not commit the real .env file.

# Runtime mode for beta validation.
NODE_ENV=beta

# Local beta defaults.
PORT=4100
FRONTEND_PORT=5174
VITE_API_BASE_URL=http://localhost:4100

# AI provider defaults.
# Supported AI_PROVIDER values: ollama, template, openai, gemini.
# Keep external API keys in the real beta environment only.
AI_PROVIDER=template
AI_MODE=auto
AI_FALLBACK_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local Ollama / Gemma 4 defaults.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_MS=30000
OLLAMA_STATUS_TIMEOUT_MS=60000

# For external deployment, change VITE_API_BASE_URL to the deployed backend origin.
# If Gemma 4 is not on the same machine, change OLLAMA_BASE_URL to the reachable Ollama/API origin.
# Keep real secrets, tokens, tunnel URLs, and production values out of git.

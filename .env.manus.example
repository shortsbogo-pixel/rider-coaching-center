# Rider Coaching Center Manus deployment environment template
# Copy values into the Manus/runtime environment. Do not commit a real .env file.

NODE_ENV=production
PORT=4100
FRONTEND_PORT=5174

# Replace with the deployed backend origin when the frontend and backend are split.
VITE_API_BASE_URL=http://localhost:4100

# Manus deployments may not be able to reach a local Ollama runtime.
# Recommended Manus default: use the deterministic template provider and mode.
AI_PROVIDER=template
AI_MODE=template
AI_FALLBACK_ENABLED=true
OPENAI_API_KEY=
GEMINI_API_KEY=

# Later external AI trials can use AI_PROVIDER=openai or AI_PROVIDER=gemini with keys set in the runtime environment only.

# Keep these for local-compatible deployments. They are ignored by template mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_MS=30000
OLLAMA_STATUS_TIMEOUT_MS=60000

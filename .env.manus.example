# Rider Coaching Center Manus deployment environment template
# Copy these values into the Manus/runtime environment.
# Do not commit a real .env file.

NODE_ENV=production
PORT=4100
FRONTEND_PORT=5174

# Set this to the deployed backend origin when frontend and backend are split.
# Leave blank only when the deployed frontend can call the backend through the same origin/proxy.
VITE_API_BASE_URL=

# Manus beta recommendation: use deterministic template operation.
# Local Ollama/Gemma 4 may not be reachable from Manus.
AI_PROVIDER=template
AI_MODE=template
AI_FALLBACK_ENABLED=true

# JSON storage is for MVP/beta validation. Review DB migration before production.
STORAGE_MODE=json

# OpenAI/Gemini are reserved for future integration.
# Current providers are safe stubs and fall back to templates without keys.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Keep these for local-compatible or tunnel-based deployments.
# They are not required when AI_PROVIDER=template and AI_MODE=template.
OLLAMA_BASE_URL=
OLLAMA_MODEL=gemma4:e2b
OLLAMA_NUM_CTX=1024
OLLAMA_NUM_PREDICT=300
OLLAMA_TIMEOUT_MS=30000
OLLAMA_STATUS_TIMEOUT_MS=60000
